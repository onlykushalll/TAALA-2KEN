# TAALA-2KEN Optional Runtime Configuration
# Copy to .env (or export in System environment) only if overriding defaults.

# Optional override for registered token JSON store path
# TAALA_CONFIG_PATH=C:\ProgramData\Taala2Ken\usb_auth_guard_config.json

# Optional override for local security audit log file (empty string disables file logging)
# TAALA_LOG_PATH=C:\ProgramData\Taala2Ken\usb_auth_guard.log

# Optional explicit path to vendor PKCS#11 DLL (e.g., ePass2003 / OpenSC)
# TAALA_PKCS11_LIB=C:\Windows\System32\eps2003csp11.dll
